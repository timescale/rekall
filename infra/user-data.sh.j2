#!/bin/bash
# Cloud-init user-data for rekall benchmark instances.
# Single source of truth for both aws_native and terraform backends.
# Rendered by rekall_lib::infra::render_user_data via minijinja.
set -euo pipefail
exec > /var/log/rekall-setup.log 2>&1

echo "=== Rekall instance setup starting ==="
date

export DEBIAN_FRONTEND=noninteractive

echo "=== Disabling background apt upgrades ==="
# A scheduled apt-daily-upgrade.service running unattended-upgrades restarts
# postgresql (directly, or via needrestart after a library upgrade) in the
# middle of a long index build — observed killing builds at ~06:44 UTC across
# instances. Stop the timers/service and turn the periodic upgrade off so a
# benchmark is never interrupted by a background upgrade.
systemctl disable --now \
  apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service 2>/dev/null || true
cat > /etc/apt/apt.conf.d/99rekall-no-auto-upgrade <<'AUTOUPEOF'
APT::Periodic::Update-Package-Lists "0";
APT::Periodic::Unattended-Upgrade "0";
APT::Periodic::Download-Upgradeable-Packages "0";
APT::Periodic::AutocleanInterval "0";
AUTOUPEOF
# needrestart (present on 24.04+) otherwise auto-restarts services after a
# library upgrade — make it only list them.
mkdir -p /etc/needrestart/conf.d
cat > /etc/needrestart/conf.d/99-rekall.conf <<'NREOF'
$nrconf{restart} = 'l';
NREOF

{% if authorized_keys -%}
echo "=== Installing team SSH keys ==="
install -d -o ubuntu -g ubuntu -m 700 /home/ubuntu/.ssh
cat >> /home/ubuntu/.ssh/authorized_keys <<'AUTHKEYSEOF'
{% for key in authorized_keys -%}
{{ key }}
{% endfor -%}
AUTHKEYSEOF
chown ubuntu:ubuntu /home/ubuntu/.ssh/authorized_keys
chmod 600 /home/ubuntu/.ssh/authorized_keys
{%- endif %}

{% if huge_pages -%}
echo "=== Configuring huge pages (vm.nr_hugepages={{ nr_hugepages }}, disable THP) ==="
echo "vm.nr_hugepages = {{ nr_hugepages }}" > /etc/sysctl.d/30-postgres-hugepages.conf
sysctl --system

echo never > /sys/kernel/mm/transparent_hugepage/enabled
echo never > /sys/kernel/mm/transparent_hugepage/defrag

cat > /etc/systemd/system/disable-thp.service << 'THPEOF'
[Unit]
Description=Disable Transparent Huge Pages
DefaultDependencies=no
After=local-fs.target
Before=postgresql.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo never > /sys/kernel/mm/transparent_hugepage/enabled && echo never > /sys/kernel/mm/transparent_hugepage/defrag'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
THPEOF

systemctl daemon-reload
systemctl enable disable-thp.service
{%- endif %}

{% if pg_on_instance_store or swap_gb > 0 -%}
# Find an NVMe instance-store device: ephemeral disks are NVMe like the
# EBS root volume, but the controller model distinguishes them ("Amazon
# EC2 NVMe Instance Storage" vs "Amazon Elastic Block Store"). Read the
# model from sysfs — this runs before any packages are installed, so
# tools like nvme-cli aren't available yet.
find_instance_store_dev() {
    local ctrl dev
    for ctrl in /sys/class/nvme/nvme*; do
        [ -r "$ctrl/model" ] || continue
        grep -qi "instance storage\|ephemeral" "$ctrl/model" || continue
        dev="/dev/$(basename "$ctrl")n1"
        [ -b "$dev" ] || continue
        # Skip devices already claimed (e.g. PGDATA took the only disk;
        # a later swap request must not reformat it).
        grep -q "^$dev " /proc/mounts && continue
        echo "$dev"
        return 0
    done
    return 1
}
{%- endif %}

{% if pg_on_instance_store -%}
echo "=== Mounting NVMe instance store for the PostgreSQL data directory ==="
# Runs BEFORE PostgreSQL is installed, so the package's initdb lands
# directly on the instance store.
PGSTORE_DEV=$(find_instance_store_dev || true)
if [ -z "$PGSTORE_DEV" ]; then
    echo "ERROR: pg_on_instance_store set but no NVMe instance store found" >&2
    exit 1
fi
echo "Found NVMe instance store: $PGSTORE_DEV"
mkfs.ext4 -F -L pgstore "$PGSTORE_DEV"
mkdir -p /var/lib/postgresql
mount -o noatime "$PGSTORE_DEV" /var/lib/postgresql
# Ephemeral: contents vanish on instance stop. Remount on reboot only.
echo "LABEL=pgstore /var/lib/postgresql ext4 noatime,nofail 0 2" >> /etc/fstab
{%- endif %}

{% if swap_gb > 0 -%}
echo "=== Configuring {{ swap_gb }} GB swap on NVMe instance store ==="
# First NVMe instance-store device (not the root EBS volume); detection
# shared with the pg-on-instance-store block above.
SWAP_DEV=$(find_instance_store_dev || true)

if [ -z "$SWAP_DEV" ]; then
    echo "WARNING: swap_gb={{ swap_gb }} requested but no NVMe instance store found. Skipping swap."
else
    echo "Found NVMe instance store: $SWAP_DEV"
    # Partition: swap_gb for swap, rest for data if needed later.
    # For simplicity, use the whole device as swap if it fits.
    SWAPFILE="/mnt/nvme-swap/swapfile"
    mkdir -p /mnt/nvme-swap

    # Format and mount a small ext4 partition for the swapfile.
    # (fallocate on XFS works; on ext4 works; raw device swap is
    # simpler but harder to share the disk for other uses later.)
    if ! mountpoint -q /mnt/nvme-swap; then
        mkfs.ext4 -F -L nvme-swap "$SWAP_DEV"
        mount "$SWAP_DEV" /mnt/nvme-swap
    fi

    if [ ! -f "$SWAPFILE" ]; then
        fallocate -l {{ swap_gb }}G "$SWAPFILE"
        chmod 600 "$SWAPFILE"
        mkswap "$SWAPFILE"
    fi
    swapon "$SWAPFILE" 2>/dev/null || true
    echo "vm.swappiness = 1" > /etc/sysctl.d/30-swap.conf
    sysctl --system
    echo "Swap active: {{ swap_gb }} GB on $SWAP_DEV"
fi
{%- endif %}

apt-get update
apt-get install -y build-essential git curl wget pkg-config \
  postgresql-common apt-transport-https ca-certificates gnupg lsb-release \
  tmux htop libhdf5-dev gnuplot-nox \
  cmake meson ninja-build clang clang-tools gdb valgrind \
  autoconf automake libtool \
  unzip gcc-14 systemd-coredump

{% if is_amd -%}
# Build AMD-optimized BLIS from source with Zen-specific microkernels.
# The Ubuntu package (libblis-dev) ships a generic build without AMD
# optimizations. AMD's fork auto-detects the Zen generation at configure
# time and selects the matching GEMM/BLAS kernels.
if [ ! -f /usr/local/lib/libblis.so ]; then
    echo "=== Building AMD BLIS from source ==="
    cd /tmp
    git clone --depth 1 https://github.com/amd/blis.git amd-blis
    cd amd-blis
    ./configure --enable-threading=openmp --prefix=/usr/local auto
    make -j"$(nproc)"
    make install
    ldconfig
    cd /tmp && rm -rf amd-blis
fi
{% else -%}
apt-get install -y libopenblas-dev
{% endif %}

# Set gcc-14 as default
update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 100
update-alternatives --install /usr/bin/cc cc /usr/bin/gcc-14 100

# AWS CLI v2
curl -sL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/aws /tmp/awscliv2.zip

/usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y
apt-get install -y postgresql-{{ pg_version }} postgresql-server-dev-{{ pg_version }}

# Everything that defines the server's state (config tuning, hba, core
# dumps, the rekall role) runs BEFORE any extension install below. The
# extension installs are network-fragile (apt mirrors, git clones); with
# set -e a failure there aborts the script, and it must not leave behind
# a running-but-untuned server (stock shared_buffers, no rekall user)
# that looks healthy from the outside.

PG_CONF="/etc/postgresql/{{ pg_version }}/main/postgresql.conf"
PG_HBA="/etc/postgresql/{{ pg_version }}/main/pg_hba.conf"

sed -i "s/#listen_addresses = 'localhost'/listen_addresses = '*'/" "$PG_CONF"
sed -i "s/^port = .*/port = {{ pg_port }}/" "$PG_CONF"

{% for key, value in pg_config | items -%}
echo "{{ key }} = '{{ value }}'" >> "$PG_CONF"
{% endfor %}
echo "host all rekall 0.0.0.0/0 scram-sha-256" >> "$PG_HBA"

echo "=== Enabling core dumps (systemd-coredump) ==="
# Ubuntu defaults to apport and discards PG backend cores. The
# systemd-coredump package (installed with the base toolchain above; sets
# kernel.core_pattern → systemd-coredump, cores land in
# /var/lib/systemd/coredump, inspect with `coredumpctl`) plus the config
# below make a pg_vectorsearch / pgvector build crash leave a debuggable core.

# No size cap: a build backend can hold many GB of maintenance_work_mem and a
# truncated core loses the heap. Compressed on disk, on the root volume.
mkdir -p /etc/systemd/coredump.conf.d
cat > /etc/systemd/coredump.conf.d/rekall.conf <<'CDEOF'
[Coredump]
Storage=external
Compress=yes
ProcessSizeMax=0
ExternalSizeMax=0
CDEOF

# The postgresql unit needs an unlimited core ulimit or backends can't dump.
mkdir -p /etc/systemd/system/postgresql@{{ pg_version }}-main.service.d
cat > /etc/systemd/system/postgresql@{{ pg_version }}-main.service.d/coredump.conf <<'CDEOF'
[Service]
LimitCORE=infinity
CDEOF

systemctl daemon-reload

systemctl restart postgresql@{{ pg_version }}-main

sudo -u postgres psql -p {{ pg_port }} -c "CREATE USER rekall WITH PASSWORD 'rekall' SUPERUSER"
sudo -u postgres psql -p {{ pg_port }} -c "CREATE DATABASE rekall OWNER rekall"

sudo -u ubuntu bash -c 'cat > ~/.tmux.conf << TMUXEOF
set-window-option -g mode-keys vi
set -g history-limit 50000
set -g default-terminal "xterm-256color"
TMUXEOF'

# --- Fault-tolerant installs --------------------------------------------
# The server state above is complete; the network-fragile installs below
# must not abort the script and leave a half-provisioned box. Each step
# runs in its own `bash -euo pipefail` child (set -e is silently disabled
# inside `if`/`||` contexts, so a plain function call would keep running
# past failures); a failing step is recorded and reported at the end, and
# rekall surfaces /tmp/rekall-setup-failures after cloud-init completes.
SETUP_FAILURES=""
try_step() {
  local name="$1" fn="$2"
  echo "=== Installing $name ==="
  if bash -euo pipefail -c "$fn"; then
    echo "=== $name: OK ==="
  else
    echo "!!! $name: FAILED — continuing with remaining setup"
    SETUP_FAILURES="${SETUP_FAILURES:+$SETUP_FAILURES }$name"
  fi
}

install_rust() {
  sudo -u ubuntu bash -c 'curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y'
}
export -f install_rust
try_step "rust" install_rust

{% if "pgvector" in extensions -%}
install_pgvector() {
  apt-get install -y postgresql-{{ pg_version }}-pgvector || {
    echo "pgvector apt package not available, building from source"
    cd /tmp
    rm -rf pgvector
    git clone --branch {{ pgvector_version }} --depth 1 https://github.com/pgvector/pgvector.git
    cd pgvector
    make PG_CONFIG=/usr/lib/postgresql/{{ pg_version }}/bin/pg_config
    make PG_CONFIG=/usr/lib/postgresql/{{ pg_version }}/bin/pg_config install
  }
}
export -f install_pgvector
try_step "pgvector {{ pgvector_version }}" install_pgvector
{%- endif %}

if [ -n "$SETUP_FAILURES" ]; then
  echo "$SETUP_FAILURES" > /tmp/rekall-setup-failures
  echo "=== Rekall instance setup complete WITH FAILURES:$SETUP_FAILURES ==="
else
  rm -f /tmp/rekall-setup-failures
  echo "=== Rekall instance setup complete ==="
fi
touch /tmp/rekall-ready
date
