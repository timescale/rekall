# Personal overrides for an instance config — gitignored, never committed.
#
# To use: copy this file to `<instance-name>.local.toml` next to its
# base TOML (e.g. `r7g.2xlarge.local.toml`) and fill in your values.
# Any field from the base TOML can be overridden here. The two below
# are required for `rekall infra up` to work.

# Path to your SSH public key. The corresponding private key (same path
# without .pub) is what `infra ssh`/`attach` will use.
ssh_key = "~/.ssh/id_ed25519.pub"

# Name of the IAM instance profile created by `rekall infra iam-policy`.
# Required so the launcher doesn't need iam:CreateRole.
iam_instance_profile = "rekall-profile"

# S3 bucket for datasets. Used to scope the IAM policy template when
# you regenerate it; not strictly required at launch time.
# s3_bucket = "my-datasets-bucket"

# Build meerkat from source on the instance. The provisioning script
# uses the per-repo deploy key in ~/.rekall/infra/deploy-keys/meerkat.
[meerkat]
git_url = "git@github.com:timescale/meerkat.git"
git_ref = "main"

# Build rekall from source on the instance (otherwise the local binary
# is used). Same deploy-key handling as meerkat.
[rekall]
git_url = "git@github.com:timescale/rekall.git"
git_ref = "main"

# Common overrides — uncomment as needed.

# ubuntu_version = "26.04"          # switch to Resolute Raccoon
# huge_pages = true                 # reserve kernel huge pages
# [pg_config]
# shared_buffers = "32GB"           # override auto-computed value
