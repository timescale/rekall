# Personal overrides for ONE instance config — gitignored, never committed.
#
# You probably do not need this file. Merge order is:
#
#     ~/.config/rekall/infra.toml  ->  <instance>.toml  ->  <instance>.local.toml
#
# The machine-wide values — ssh_key, iam_instance_profile, s3_bucket, the
# pg_vectorsearch/rekall git URLs — belong in ~/.config/rekall/infra.toml, where
# they are stated once for every box. A .local.toml is for the cases where
# ONE box must differ: benchmarking a pg_vectorsearch feature branch, a bigger disk
# for a bigger dataset, a different IAM profile.
#
# To use: copy this file to `<instance-name>.local.toml` next to its
# base TOML (e.g. `r7g.2xlarge.local.toml`) and set only what differs.
# Any field from the base TOML can be overridden here.
#
# TOML gotcha: top-level fields (ssh_key, iam_instance_profile,
# ubuntu_version, huge_pages, ...) MUST appear before any [section]
# header. Once you write [pg_vectorsearch] etc., everything after belongs to
# that section. The format is flat — there is no [infra] wrapper.

# SSH public key. Defaults to ~/.ssh/id_ed25519.pub — only set this if
# you use a different key. Both the public key (uploaded to AWS as the
# EC2 key pair) and the corresponding private key (used by infra ssh /
# attach) are derived from this single path.
# ssh_key = "~/.ssh/id_ed25519.pub"

# Machine-wide values below are better placed in
# ~/.config/rekall/infra.toml. Set them here only to override that file
# for this one box.
# iam_instance_profile = "rekall-profile"

# S3 bucket for datasets. Used to scope the IAM policy template when
# you regenerate it; not strictly required at launch time.
# s3_bucket = "my-datasets-bucket"

# The canonical reason to have this file: benchmark ONE box against a
# pg_vectorsearch feature branch. git_url is inherited from the global file, so
# only the ref needs restating.
# [pg_vectorsearch]
# git_ref = "feat/my-branch"

# Common overrides — uncomment as needed.

# ubuntu_version = "26.04"          # switch to Resolute Raccoon
# huge_pages = true                 # reserve kernel huge pages
# [pg_config]
# shared_buffers = "32GB"           # override auto-computed value
