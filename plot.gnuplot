set terminal qt size 1200,700 enhanced font 'sans,12'

set title 'Recall vs QPS'
set xlabel 'Recall@10'
set ylabel 'Queries per second'
set grid
set key left bottom box opaque

set logscale y
set format y '%.0s%cQPS'
# Logit scale for recall axis
set nonlinear x via log(x/(1.0-x)) inverse 1.0/(1.0+exp(-x))
set xrange [0.5:0.999]
set xtics ("0.5" 0.5, "0.6" 0.6, "0.7" 0.7, "0.8" 0.8, "0.85" 0.85, "0.9" 0.9, "0.925" 0.925, "0.95" 0.95, "0.975" 0.975, "0.99" 0.99, "0.995" 0.995, "0.999" 0.999)

