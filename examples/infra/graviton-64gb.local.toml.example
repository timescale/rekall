# Local overrides (gitignored, never committed)
# Copy to graviton-64gb.local.toml and fill in your values.

ssh_key = "~/.ssh/id_ed25519.pub"
iam_instance_profile = "rekall-profile"

[rekall]
git_url = "git@github.com:timescale/rekall.git"
git_ref = "main"

[meerkat]
git_url = "git@github.com:timescale/meerkat.git"
git_ref = "main"
